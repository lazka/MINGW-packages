Backport the IPv6 socket-option fix from:
https://github.com/eclipse-mosquitto/mosquitto/commit/a21362c2f6703c3e1424233f0781425f2c5a142d

Winsock's setsockopt takes const char *, unlike POSIX's const void *.
Use the upstream cast to make the call compile with strict C compilers.

--- a/src/net.c
+++ b/src/net.c
@@ -761,7 +761,7 @@
 #endif
 #ifdef IPV6_V6ONLY
 		ss_opt = 1;
-		(void)setsockopt(sock, IPPROTO_IPV6, IPV6_V6ONLY, &ss_opt, sizeof(ss_opt));
+		(void)setsockopt(sock, IPPROTO_IPV6, IPV6_V6ONLY, (const void *)&ss_opt, sizeof(ss_opt));
 #endif
 
 		if(net__socket_nonblock(&sock)){
