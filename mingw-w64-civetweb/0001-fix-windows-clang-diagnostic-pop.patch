The matching diagnostic push is inside the non-Windows branch. Only pop
on that branch, avoiding an unmatched-pop error with Clang on Windows.

--- a/src/main.c
+++ b/src/main.c
@@ -81,7 +81,7 @@
 #define __STDC_LIMIT_MACROS /* C++ wants that for INT64_MAX */
 #endif
 
-#if defined(__clang__)
+#if defined(__clang__) && !defined(_WIN32)
 /* Enable reserved-id-macro warning again. */
 #pragma GCC diagnostic pop
 #endif
